		new Main().run();
//        long usedMemory = runtime.totalMemory() - runtime.freeMemory();
//        System.err.printf("使用メモリ: %.2f MB%n", usedMemory / 1024.0 / 1024.0);
		MyPrintWriter.getInstance().flush();
		;
